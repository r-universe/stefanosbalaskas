[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "gp3bayes"]
	path = gp3bayes
	url = https://github.com/stefanosbalaskas/gp3bayes
[submodule "gp3ml"]
	path = gp3ml
	url = https://github.com/stefanosbalaskas/gp3ml
[submodule "gp3sequences"]
	path = gp3sequences
	url = https://github.com/stefanosbalaskas/gp3sequences
[submodule "gp3tools"]
	path = gp3tools
	url = https://github.com/stefanosbalaskas/gp3tools
[submodule "gpbiometrics"]
	path = gpbiometrics
	url = https://github.com/stefanosbalaskas/gpbiometrics
